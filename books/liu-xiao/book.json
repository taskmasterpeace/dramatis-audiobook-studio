  "chapters": [
    {
      "heading": "Chapter One",
      "scenes": [
        { "id": "c1-parlor", "anchor": "The rain came early that evening", "ambience": { "type": "rain", "intensity": 0.35 } },
        { "id": "c1-vigil", "anchor": "He found his cane where it leaned", "ambience": { "type": "rain", "intensity": 0.7 } },
        { "id": "c1-walk", "anchor": "He stood. He shook out the cheap plastic poncho", "ambience": { "type": "rain", "intensity": 1.0 } },
        { "id": "c1-encounter", "anchor": "It came from up ahead, across the street", "ambience": { "type": "rain", "intensity": 1.0, "drone": true } },
        { "id": "c1-courtyard", "anchor": "He woke on his back, on concrete", "ambience": { "type": "roomtone-morning", "intensity": 0.6 } }
      ],
      "cues": [
        { "id": "c1-thunder-1", "sfx": "thunder-distant", "anchor": "The rain came early that evening", "offset": 1.0, "gain_db": -8 },
        { "id": "c1-thunder-2", "sfx": "thunder-distant", "anchor": "The rain thickened", "offset": 2.0, "gain_db": -5 },
        { "id": "c1-weight", "sfx": "impact-boom", "anchor": "Instead, the weight came", "offset": 0.3, "gain_db": -2 },
        { "id": "c1-tear", "sfx": "riser-tear", "anchor": "and then nothing at all", "offset": 0.0, "gain_db": -6 },
        { "id": "c1-hum", "sfx": "sphere-hum", "anchor": "There were five of them", "offset": 0.5, "dur": 90, "gain_db": -14 },
        { "id": "c1-snap", "sfx": "tentacle-snap", "anchor": "A tentacle uncoiled from the nearest sphere", "offset": 1.2, "gain_db": -3 }
      ]
    },
    {
      "heading": "Chapter Two",
      "scenes": [
        { "id": "c2-convulse", "anchor": "For three or four seconds, the young man convulsed", "ambience": { "type": "crowd", "intensity": 0.4 } },
        { "id": "c2-crowd", "anchor": "The crowd had grown", "ambience": { "type": "crowd", "intensity": 0.75 } },
        { "id": "c2-yard", "anchor": "They did not go far", "ambience": { "type": "roomtone-morning", "intensity": 0.3 } },
        { "id": "c2-stairwell", "anchor": "Liu started toward the stairwell", "ambience": { "type": "room-hum", "intensity": 0.4 } }
      ],
      "cues": [
        { "id": "c2-snap-2", "sfx": "tentacle-snap", "anchor": "Then it struck the second man too", "offset": 0.3, "gain_db": -4 },
        { "id": "c2-hum", "sfx": "sphere-hum", "anchor": "They are trying to help me", "offset": 0.0, "dur": 45, "gain_db": -16 },
        { "id": "c2-lift", "sfx": "riser-tear", "anchor": "The flying man caught him under the arms", "offset": 0.5, "dur": 3, "gain_db": -10 }
      ]
    },
    {
      "heading": "Chapter Three",
      "scenes": [
        { "id": "c3-corridor", "anchor": "There were four officers in the corridor", "ambience": { "type": "room-hum", "intensity": 0.5 } },
        { "id": "c3-courtyard", "anchor": "They went down together", "ambience": { "type": "crowd", "intensity": 0.5 } },
        { "id": "c3-station", "anchor": "They questioned him for a long time", "ambience": { "type": "room-hum", "intensity": 0.4 } },
        { "id": "c3-facility", "anchor": "They moved him before dawn", "ambience": { "type": "lab-cold", "intensity": 0.4 } }
      ],
      "cues": [
        { "id": "c3-radio", "sfx": "radio-crackle", "anchor": "There were four officers in the corridor", "offset": 2.0, "gain_db": -14 },
        { "id": "c3-hum", "sfx": "sphere-hum", "anchor": "They go where I go", "offset": 0.0, "dur": 30, "gain_db": -18 }
      ]
    },
    {
      "heading": "Chapter Four",
      "scenes": [
        { "id": "c4-dressing", "anchor": "They dressed him for the dinner", "ambience": { "type": "room-hum", "intensity": 0.3 } },
