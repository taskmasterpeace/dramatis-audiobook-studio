      ],
      "cues": [
        { "id": "c4-hum", "sfx": "sphere-hum", "anchor": "the spheres arranged themselves at his back", "offset": 0.0, "dur": 40, "gain_db": -19 }
      ]
    },
    {
      "heading": "Chapter Five",
      "scenes": [
        { "id": "c5-signed", "anchor": "Liu Xiao was exhausted", "ambience": { "type": "room-hum", "intensity": 0.3 } },
        { "id": "c5-plaza", "anchor": "They released him at dusk", "ambience": { "type": "crowd", "intensity": 1.0 } },
        { "id": "c5-training", "anchor": "The Test came three months later", "ambience": { "type": "roomtone-morning", "intensity": 0.4 } },
        { "id": "c5-battle", "anchor": "The attack, when it came, did not announce itself", "ambience": { "type": "battle", "intensity": 0.7 } },
        { "id": "c5-standoff", "anchor": "The mutants saw him", "ambience": { "type": "battle", "intensity": 1.0 } },
        { "id": "c5-home", "anchor": "Liu Xiao went home to Pinggu that night", "ambience": { "type": "room-hum", "intensity": 0.3 } }
      ],
      "cues": [
        { "id": "c5-heli", "sfx": "helicopter", "anchor": "They put Liu in a helicopter", "offset": 0.5, "dur": 14, "gain_db": -10 },
        { "id": "c5-giant", "sfx": "impact-boom", "anchor": "the giant went down full-length on the highway", "offset": 0.0, "gain_db": -4 },
        { "id": "c5-radio-2", "sfx": "radio-crackle", "anchor": "The order came back through the radio", "offset": 0.0, "gain_db": -10 },
        { "id": "c5-grief", "sfx": "keening", "anchor": "humming a low grieving note", "offset": 0.0, "dur": 20, "gain_db": -14 }
      ]
    },
    {
      "heading": "Chapter Six",
      "scenes": [
        { "id": "c6-terrace", "anchor": "They sent a man named Muyang Yang to watch him", "ambience": { "type": "city-night", "intensity": 0.5 } },
        { "id": "c6-shanghai", "anchor": "The attack on Shanghai came while Muyang Yang was still watching", "ambience": { "type": "battle", "intensity": 1.0 } },
        { "id": "c6-winter", "anchor": "The cough began that winter", "ambience": { "type": "room-hum", "intensity": 0.3 } },
        { "id": "c6-count", "anchor": "But he could not hide it from the watcher", "ambience": { "type": "city-night", "intensity": 0.6 } }
      ],
      "cues": [
        { "id": "c6-hum", "sfx": "sphere-hum", "anchor": "You are not what you seem", "offset": 0.0, "dur": 30, "gain_db": -18 },
        { "id": "c6-sea", "sfx": "impact-boom", "anchor": "a thing that had walked out of the sea onto the Bund", "offset": 0.0, "gain_db": -8 },
        { "id": "c6-scream", "sfx": "keening", "anchor": "felt all five of his children scream at once", "offset": 0.0, "dur": 10, "gain_db": -8 }
      ]
    },
    {
      "heading": "Chapter Seven",
      "scenes": [
        { "id": "c7-lab", "anchor": "He went down to the laboratory first", "ambience": { "type": "lab-cold", "intensity": 0.7 } },
        { "id": "c7-truth", "anchor": "It gave him the truth", "ambience": { "type": "lab-cold", "intensity": 0.5, "drone": true } },
        { "id": "c7-stairs", "anchor": "The four remaining spheres waited for him at the top of the stairs", "ambience": { "type": "room-hum", "intensity": 0.3 } }
      ],
      "cues": [
        { "id": "c7-grief", "sfx": "keening", "anchor": "was grief given a voice", "offset": 0.0, "dur": 30, "gain_db": -10 },
        { "id": "c7-truth", "sfx": "riser-tear", "anchor": "It gave him the truth", "offset": 0.0, "gain_db": -10 },
        { "id": "c7-out", "sfx": "keening", "anchor": "and then it went out", "offset": 0.0, "dur": 12, "gain_db": -14 }
      ]
    },
    {
      "heading": "Chapter Eight",
      "scenes": [
        { "id": "c8-office", "anchor": "He found the President in the small private office", "ambience": { "type": "room-hum", "intensity": 0.25 } },
        { "id": "c8-project", "anchor": "It began as a secret", "ambience": { "type": "city-night", "intensity": 0.4 } },
        { "id": "c8-episode", "anchor": "Liu watched the first episode alone", "ambience": { "type": "room-hum", "intensity": 0.3 } },
        { "id": "c8-terrace", "anchor": "And sometimes, on the high terrace above the burning city", "ambience": { "type": "city-night", "intensity": 0.5 } }
      ],
      "cues": [
        { "id": "c8-grief", "sfx": "sphere-hum", "anchor": "The four spheres hummed their low grief in the doorway", "offset": 0.0, "dur": 30, "gain_db": -16 },
        { "id": "c8-humback", "sfx": "sphere-hum", "anchor": "his four gentle spheres hummed back", "offset": 0.0, "dur": 30, "gain_db": -13 }
      ]
    }
